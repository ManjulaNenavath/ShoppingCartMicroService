<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel="tests" runs each <test> block below on its own thread, so the three
  services are exercised concurrently. Tests WITHIN a class still run in priority
  order on a single thread, which is what our chained user/cart lifecycles need.

  The ExtentReporter listener builds reports/ExtentReport.html.
  Allure results are captured automatically via the aspectj weaver (see pom.xml)
  and land in target/allure-results.
-->
<suite name="OnlineStoreAPISuite" parallel="tests" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="utils.ExtentReporter"/>
    </listeners>

    <test name="UserServiceTests">
        <classes>
            <class name="testcases.UserTests"/>
        </classes>
    </test>

    <test name="ProductServiceTests">
        <classes>
            <class name="testcases.ProductTests"/>
        </classes>
    </test>

    <test name="CartServiceTests">
        <classes>
            <class name="testcases.CartTests"/>
        </classes>
    </test>

    <test name="ContractSchemaTests">
        <classes>
            <class name="testcases.SchemaTests"/>
        </classes>
    </test>

</suite>
